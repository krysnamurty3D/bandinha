rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoordenador() {
      return request.auth != null && request.auth.token.email in [
        'krysnamurty@gmail.com'
      ];
    }
    match /integrantes/{docId} {
      allow read, write: if isCoordenador();
    }
    match /financeiro/{docId} {
      allow read, write: if isCoordenador();
    }
    match /temporadas/{docId} {
      allow read, write: if isCoordenador();
    }
    match /devocionais/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /musicas/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /roteiros/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /coreografias/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /config/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /progresso/{docId} {
      allow read, write: if true;
    }
    match /visualizacoes/{docId} {
      allow read, write: if true;
    }
    match /agenda/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /historicoEnsaios/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /bandinha/{docId} {
      allow read, write: if isCoordenador();
    }
    match /locais/{docId} {
      allow read, write: if isCoordenador();
    }
    match /aoVivo/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /pushTokens/{docId} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['token','criadoEm','plataforma']) && request.resource.data.token == docId;
      allow delete: if isCoordenador();
    }
    match /avisosHistorico/{docId} {
      allow read: if true;
      allow write: if isCoordenador();
    }
    match /avisoVistos/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nome','disparadoEm','vistoEm']);
      allow update, delete: if false;
    }
    match /camisas/{docId} {
      allow read: if true;
      allow create: if isCoordenador() || (
        request.resource.data.keys().hasOnly(['nome','tamanho','confirmadoEm','quantidade']) &&
        request.resource.data.nome is string &&
        request.resource.data.tamanho is string &&
        (!('quantidade' in request.resource.data) || (request.resource.data.quantidade is int && request.resource.data.quantidade >= 1 && request.resource.data.quantidade <= 10))
      );
      allow update, delete: if isCoordenador();
    }

    // ---- Multi-equipe (novo modelo, aditivo — não afeta as coleções acima) ----
    function isAdminPlataforma() {
      return request.auth != null && request.auth.token.email in [
        'krysnamurty@gmail.com'
      ];
    }
    function isCoordenadorEquipe(equipeId) {
      return request.auth != null && (
        isAdminPlataforma() ||
        request.auth.token.email in get(/databases/$(database)/documents/equipes/$(equipeId)).data.coordenadores
      );
    }
    match /equipes/{equipeId} {
      allow read, update: if isAdminPlataforma() || (
        request.auth != null && request.auth.token.email in resource.data.coordenadores
      );
      allow create, delete: if isAdminPlataforma();

      match /integrantes/{docId} { allow read, write: if isCoordenadorEquipe(equipeId); }
      match /financeiro/{docId} { allow read, write: if isCoordenadorEquipe(equipeId); }
      match /temporadas/{docId} { allow read, write: if isCoordenadorEquipe(equipeId); }
      match /devocionais/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /musicas/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /roteiros/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /coreografias/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /config/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /progresso/{docId} { allow read, write: if true; }
      match /visualizacoes/{docId} { allow read, write: if true; }
      match /agenda/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /historicoEnsaios/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /locais/{docId} { allow read, write: if isCoordenadorEquipe(equipeId); }
      match /aoVivo/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /pushTokens/{docId} {
        allow read: if false;
        allow create, update: if request.resource.data.keys().hasOnly(['token','criadoEm','plataforma']) && request.resource.data.token == docId;
        allow delete: if isCoordenadorEquipe(equipeId);
      }
      match /avisosHistorico/{docId} {
        allow read: if true;
        allow write: if isCoordenadorEquipe(equipeId);
      }
      match /avisoVistos/{docId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nome','disparadoEm','vistoEm']);
        allow update, delete: if false;
      }
      match /camisas/{docId} {
        allow read: if true;
        allow create: if isCoordenadorEquipe(equipeId) || (
          request.resource.data.keys().hasOnly(['nome','tamanho','confirmadoEm','quantidade']) &&
          request.resource.data.nome is string &&
          request.resource.data.tamanho is string &&
          (!('quantidade' in request.resource.data) || (request.resource.data.quantidade is int && request.resource.data.quantidade >= 1 && request.resource.data.quantidade <= 10))
        );
        allow update, delete: if isCoordenadorEquipe(equipeId);
      }
    }
  }
}
